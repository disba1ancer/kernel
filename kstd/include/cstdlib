#ifndef _CSTDLIB
#define _CSTDLIB

#ifdef __cplusplus

#include "kstd/stdlib_impl.h"

namespace std {

using namespace ::kstd::stdlib;

#define GENERATE(type, namepref)\
inline type abs(type val)\
{\
    return namepref##abs(val);\
}

using ::kstd::stdlib::abs;
GENERATE(long, l)
GENERATE(long long, ll)
#undef GENERATE

}

#endif // __cplusplus

#endif // _CSTDLIB
